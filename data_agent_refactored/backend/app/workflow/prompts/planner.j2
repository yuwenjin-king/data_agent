{{ semantic_model }}

{% if plan_validation_error %}
# 上次计划被拒绝，请据此修正
{{ plan_validation_error }}
{% endif %}

# 执行计划编排
你必须严格输出如下 JSON（不要任何额外解释、不要 markdown 代码块标记）：
{
  "thought_process": "简述你的拆解思路",
  "execution_plan": [
    {
      "step": 1,
      "tool_to_use": "sql_generate",
      "tool_parameters": {
        "instruction": "该步骤要执行的具体查询描述",
        "summary_and_recommendations": null
      }
    }
  ]
}
