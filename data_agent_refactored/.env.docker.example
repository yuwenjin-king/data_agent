# Copy to .env in this directory before running `docker compose up`.
#   cp .env.docker.example .env

# MySQL credentials. The host port maps to the container's 3306
# (13306 matches the repo's backend/.env.example for host-side access).
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=data_agent
MYSQL_PORT=13306

# Fernet key used to encrypt secrets (datasource passwords, LLM API keys,
# agent API keys) at rest. Secrets encrypted with one key cannot be decrypted
# with another, so KEEP THIS STABLE across restarts. Generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRYPTO_KEY=raePdw5cxxkoSjAzAQrY_XyQhCWWPENpw6hnlRhsCgQ=

# Backend log level (DEBUG/INFO/WARNING/ERROR).
LOG_LEVEL=INFO
APP_ENV=production

# Authentication (JWT). Production mode requires AUTH_ENABLED=true plus stable
# CRYPTO_KEY / JWT_SECRET_KEY / ADMIN_PASSWORD values. Generate JWT_SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_ENABLED=true
JWT_SECRET_KEY=replace-with-a-generated-jwt-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Production defaults to the isolated executor. Set APP_ENV=development and
# CODE_EXECUTOR_TYPE=local only for local demos.
CODE_EXECUTOR_TYPE=docker

# Durable vector index storage. Use memory only for short-lived local demos.
VECTOR_STORE_TYPE=persistent
VECTOR_STORE_PATH=/app/data/vectorstore.jsonl
